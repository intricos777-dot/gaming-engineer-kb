{
  "schema_version": "1.0",
  "geometry": {
    "draco": {
      "ratio": [8, 16],
      "level": { "iteration": 4, "production": 7, "final": 10 },
      "quantize_bits": { "position": 11, "normal": 8, "texcoord": 10, "vertex_color": 8 }
    }
  },
  "texture": {
    "ktx2": {
      "encodings": {
        "etc1s": { "use": "albedo + ORM color maps", "toktx": "--encode etc1s --clevel 4 --qlevel 192" },
        "uastc": { "use": "normal + metallic precision", "toktx": "--encode uastc --uastc_quality 3" }
      },
      "transcode": { "desktop": "BC7/BC5", "mobile": "ETC2", "apple": "ASTC" },
      "quality": { "max": 255, "production": 128, "web": [64, 96] },
      "compression_level": { "fast": 1, "production": [2, 3], "final": [4, 5] },
      "vram_gain": [4, 8]
    },
    "fallback": {
      "delivery": "WEBP",
      "compatibility": "JPEG/PNG",
      "translation_vc": "PNG"
    }
  },
  "gltf_transform_pipeline": {
    "build_cmd": "npx @gltf-transform/cli optimize in.glb out.glb --texture-compress ktx2 --texture-size 1024 --draco",
    "passes": {
      "prune": "strip unused nodes/materials/accessors",
      "dedup": "merge duplicate buffers/accessors",
      "resample": "drop redundant animation keyframes",
      "flatten": "collapse static hierarchy (props only)",
      "weld": "merge nearby verts (LOD prep)"
    },
    "repo_rule": {
      "raw": "committed sources",
      "optimized": "gitignored build output, regenerated by CI/task"
    }
  },
  "validation": {
    "tool": "npx gltf-validator asset.glb",
    "errors_required": 0,
    "checks": [
      "power-of-two textures",
      "green-dominant normal (OpenGL +Y)",
      "0 non-manifold",
      "origins at logical 0,0,0",
      "descriptive bone names",
      "copyright metadata set"
    ]
  },
  "size_math": {
    "raw_character_glb_mb": [15, 40],
    "optimized_character_glb_mb": [3, 8],
    "vram_2048_pbr_set_png_mb": 48,
    "vram_2048_pbr_set_ktx2_mb": 6
  }
}